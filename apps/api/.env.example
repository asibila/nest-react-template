# API listener.
# `HOST` defaults to 127.0.0.1, which keeps local runs private. Platforms that
# proxy traffic to the container (Render, Fly, Docker) need HOST=0.0.0.0,
# otherwise the port never becomes reachable from outside.
HOST=127.0.0.1
PORT=3000

# Optional: serve a different React build folder (production only).
# WEB_DIST_DIR=apps/web/dist
